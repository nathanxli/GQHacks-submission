MASSIVE_API_KEY=your-key-here

# NASA FIRMS — free MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Needed to refresh disruption events with --firms / REFRESH_EVENTS; cached events work without it.
FIRMS_MAP_KEY=your-firms-map-key-here

FIRMS_SOURCE=VIIRS_SNPP_NRT

# Facility labeling (used by track fetch scripts; notebook uses PERSIST_DAYS in-cell by default)
FACILITY_PERSIST_DAYS=3
FACILITY_SITES=tracks/physical_facility_disruption/data/sites.json